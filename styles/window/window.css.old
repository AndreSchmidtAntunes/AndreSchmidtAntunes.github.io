*{
    margin: 0;
    box-sizing: border-box;
    --win95Color: #10ebbc;
    --screenWidth: 
    --screenHeight: 
}

.window {
    display: block;
    width: 500em;
    height: 600em;
    z-index: 10; 
    min-width: 75em;
    min-height: 40em;
    max-width: 100vw;
    max-height: 100vh;
    position: absolute;
    transition: box-shadow 0.1s;
    animation-fill-mode: forwards;
    left: calc(var(--screenWidth)/2 - 250em);
    top: calc(var(--screenHeight)/2 - 300em);

    .resizeWindowIcon {
        position: absolute;
        right: -5em;
        bottom: -5em;
        width: 28em;
        height: 28em;

        z-index: 3;
        filter: drop-shadow(6em 6em rgba(74, 5, 70, 0.849));

        pointer-events: none;
        display: none;
    }

    .body {
        overflow: hidden;
        height: 100%;
        width: 100%;
        background-image: url(../Images/Backgrounds/dithered-pink-to-orange.png);
        background-size: cover;
        border-style: outset;
        border-color:  #ffb61a #65abc7 rgb(236, 109, 158) #40d1a8;
        border-width: 3em;
        padding: 2em;

        .topBar {
            height: 15em;
            background: url(../Images/Backgrounds/titlebar.png);
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding-left: 25em;

            #topbar-padding {
                width: 10%; 
                max-width: 250em;
            }

            .topbar-title {
                
                border-style: inset;
                border-color: #42e4b6 #ffd06b #b5f2a2 rgb(190, 47, 102);
                border-width: 2em;
                background-color: #723080;
                
                width:90%;
                max-width: 90%;
                height: calc(100% + 5em);
                align-content: center;
                
                p {
                    margin-left: 3em;
                    color: #8effcc;
                    font-size: x-small;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
            }

            .topBtns {
                display: inline-block;
                min-width: fit-content;
                max-width: fit-content;
                width: fit-content;
                display: block;
                
                .topBtn {
                    display: inline-block;
                    border-style: outset;
                    border-color: rgb(255, 201, 65) rgb(255, 201, 65) rgb(255, 201, 65) rgb(255, 224, 145);
                    border-width: 4em;
                    min-height: 1em;
                    min-width: 1em;
                    margin: 0;
                    margin-left: -2.25em;
                    margin-right: -2.25em;
                    button {
                        position:relative;
                        padding: 0.1em;
                        font-size: 1.5vh;
                    }
                }

                .topBtn:hover {
                    z-index: 150;
                    background-color: rgb(255, 146, 116);
                    border-color: rgba(0, 0, 0, 0) rgb(255, 240, 193) rgba(0, 0, 0, 0) rgb(255, 224, 145);
                    border-right-style: inset;

                    scale: 1;
                    transform: none;
                }

                #fullscreenBtn {
                    background-color: rgb(126, 225, 167);
                }

                #fullscreenBtn:hover {
                    background-color: rgb(255, 146, 116);
                }

                #closeBtn {
                    background-color: #baea90;
                }
                #closeBtn:hover {
                    background-color: rgb(255, 146, 116);
                }
            }
        }

        .inner-body {
            position: absolute;
            margin-top: 3em;
            overflow: hidden;
            overflow-x: hidden;
            border-style: inset;
            border-color: rgb(66, 228, 182) #ffd06b #b5f2a2 rgb(244, 96, 194);
            height: calc(100% - 30em);
            width: calc(100% - 10em);
        }

        .overlay {
            pointer-events: auto;
            position:absolute;
            top: 0; 
            left: 0; 
            width: 100%; 
            height: 100%; 
            z-index: 10;
        } 
    }
}

.window.focused {
    box-shadow:
    8em 8em 0 -2em rgba(50, 2, 47, 0.639);

    
    .overlay { 
        pointer-events: none; 
    }

    .resizeWindowIcon {
        display: block;
    }
}

.unpadded {
    padding: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.inner-body {
    h2 {
        font-family: yoster;
        text-align: center;
        font-size: 35em;
        margin: 1em;
        color:rgb(159, 19, 128);
    }

    p,li,label,h3 {
        font-family: dogicapixel;
        text-align: left;
        font-size:  10em;
        word-spacing: 0.5em;
        line-height: 1.5em;
        
        color:rgb(255, 247, 247);

        b.emoji {
            font-size: 20em;
            line-height-step: 2em;
        }
    }

    li {
        list-style-type: '☆';
        list-style-position: outside;
        padding-inline-start: 1em;
        margin-bottom: 2em;
    }

    h3 {
        font-family: dogicapixel;
        font-size: 1em;
        margin-top: 1em;
        margin-bottom: 1em;
        color: rgb(87, 60, 91);
    }   

    b {
        display: inline-block;
        font-size: 1em;
        color: #9cffd2;
    }

    img.inset{
        border-style: inset;
        border-width: 0.5em;
        border-color: rgb(66, 228, 182) #ffd06b #b5f2a2 rgb(244, 96, 194);
    }

    img.floatLeft {
        float: left;
        margin: 2em;
    }

    img.floatRight {
        float: right;
        margin: 2em;
    }
}

.topbar-title p {
    font-family: yoster;
    font-size: 16em;
}

#loading-bg {

    width: 100%;
    height: 100%;
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;

    img {
        z-index: -1;
        width: 48em;
        height: auto;
    }
}

.window.fullscreen .resizeWindowIcon {
    display: none;
    pointer-events: none;
}

@keyframes fullScreenStart {
    0% {
        embed {
            display: none;
        }

        div {
            display: none;
        }
    }

    100% {
        left: 0;
        top: 0;
        height: 100%;
        width: 100%;

        embed {
            display: block;
        }
        div {
            display: block;
        }
    }
}

@keyframes fullScreen {
    0% {
        left: 0;
        top: 0;
        height: 100%;
        width: 100%;
    }
    100% {
        left: 0;
        top: 0;
        height: 100%;
        width: 100%;
    }
}

@keyframes fullScreenEnd {
    0% {
        left: 0;
        top: 0;
        height: 100%;
        width: 100%;

        embed {
            display: none;
        }
        div {
            display: none;
        }
    }

    100% {
        embed {
            display: block;
        }
        div {
            display: block;
        }
    }
}

@keyframes closeWindow {
    0% {
        transform: scale(1, 1);
        box-shadow: none;
    }
    50% {
        transform: scale(0.2, 1.3);
    }

    100% {
        transform: scale(0, 0.3);
        filter:brightness(10);
    }


}

@keyframes openWindow {
    0% {
        transform: scale(0, 0.3);
        filter:brightness(10);
        box-shadow: none;
    }

    50% {
        transform: scale(0.7, 1.3);
        
    }

    100% {
        transform: scale(1, 1);
        filter: none;
    }

}

@keyframes alertToWindow {
    0% {
        transform: rotate(4deg);
        filter: brightness(1.15) hue-rotate(80deg);
    }

    25% {
        transform: rotate(10deg);
    }

    50% {
        
        transform: rotate(-6deg);
    }

    75% {
        transform: rotate(2deg);
    }

    100% {
        transform: rotate(0deg);
        filter: none;
    }
}

.topBtns button {
    font-family: marlett;
    color:rgb(50, 91, 91);
    font-weight: 700S;
    border-width: 0;
    padding: 0;
    margin-top: 0;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    background: none;
    width: fit-content;
    height: fit-content;
}

/* box+scrollbar base styling */

.boxContent {
    
    overflow: scroll;
    scrollbar-width: none;
    padding: 10em;
    width: 100%;
    display: flex;
    flex-direction: column;
}

.scrollBox {
    scrollbar-width: none;
    display: flex;
    z-index: 1;
}

.scrollBar {
    margin:0;
    padding:0;
    width: 1em;

    /*appearance: slider-vertical;*/
    /*-webkit-appearance: slider-vertical;*/
    
    writing-mode: vertical-lr; 
    direction: rtl;
    
    background-color: rgba(0, 0, 0, 0);
    
    z-index: 100;
}

/* The following rules will only work for their respective browser */
/* Firefox */

input[type=range].scrollBar::-moz-range-thumb {
    box-shadow:
        inset -1em -1em 0em 0em rgb(255, 0, 217),
        inset -2em -2em 0em 0em rgba(97, 7, 89, 0.144),
        inset 2em 2em 0em 0em rgba(244, 255, 246, 0.883),
        inset 90em 90em 0em 0em var(--win95Color);
    height: 6em;
    width: 1em;
    border: none;
    background: var(--win95Color);
    box-sizing: border-box;
}

input[type=range].scrollBar::-moz-range-track {
    background: url("../Images/Backgrounds/dithered-pink-to-orange.png"), var(--win95Color);
    background-blend-mode: overlay, normal;
    background-size: cover;
    width: 1em;

    box-sizing: border-box;
}

/* Chromium */
/* Chrome sucks ass so if your css doesnt look good on it, */
/* just put a button on ur page that says "download firefox" */
/* Then it's magically not your problem anymore */

input[type=range].scrollBar::-webkit-slider-thumb {
    -webkit-appearance: none;
    box-shadow:
        inset -1em -1em 0em 0em rgb(255, 0, 217),
        inset -2em -2em 0em 0em rgba(97, 7, 89, 0.144),
        inset 2em 2em 0em 0em rgba(244, 255, 246, 0.883),
        inset 90em 90em 0em 0em var(--win95Color);
    height: 6em;
    width: 1em;
    border: none;
    background: var(--win95Color);
    box-sizing: border-box;
}

input[type=range].scrollBar::-webkit-slider-runnable-track {
    background: url("../Images/Backgrounds/dithered-pink-to-orange.png"), var(--win95Color);
    background-blend-mode: overlay, normal;
    background-size: cover;
    width: 1em;
    box-sizing: border-box;
}

/* stuff to hide the default scrollbar for chrome don't edit */
.boxContent::-webkit-scrollbar {
    display: none;
    width: 0;
    background: transparent;
}